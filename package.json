{
  "name": "superdaw",
  "productName": "SuperDAW",
  "version": "1.1.0",
  "description": "A collaboration-first professional DAW",
  "author": "Abzerofin",
  "license": "GPL-3.0-or-later",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p server/tsconfig.json",
    "test": "vitest run",
    "relay": "node server/src/index.ts",
    "dist": "electron-vite build && electron-builder --win --dir",
    "build:installer": "electron-vite build && electron-builder --win --publish never"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Abzerofin/SuperDAW.git"
  },
  "build": {
    "appId": "app.superdaw",
    "productName": "SuperDAW",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/vst3host/build/Release/vst3host.node",
        "to": "native/vst3host/build/Release/vst3host.node"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": ["github"]
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "node-addon-api": "^8.9.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
