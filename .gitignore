node_modules/
out/
dist/
release/
*.log
.DS_Store
release-staging/

# Vendored third-party SDK (MIT-licensed, pulled from GitHub — not ours to
# commit; native/README or setup docs should explain how to fetch it).
native/vst3sdk/

# Saved projects. .sdaw files are DAW output (a zip of state + audio
# assets), not source — they are large binaries and git handles them badly.
Songs/

# Local tool config: launch.json pins an absolute path to this machine's
# Node install, so it is per-developer, not project state.
.claude/launch.json

# node-gyp output. Explicit rather than relying on the `release/` rule
# above, which only matches build/Release/ by accident of Windows
# case-insensitivity and would leak on Linux/macOS.
native/**/build/
